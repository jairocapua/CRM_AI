{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/progress.mjs *)",
      "Bash(node --test *)",
      "Bash(date *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npm ls *)",
      "Bash(npx playwright *)",
      "Bash(npx vitest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git restore --staged *)",
      "PowerShell(node scripts/progress.mjs *)",
      "PowerShell(node --test *)",
      "PowerShell(date *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "PowerShell(npm install *)",
      "PowerShell(npm ls *)",
      "PowerShell(npx playwright *)",
      "PowerShell(npx vitest *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git merge-base *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore --staged *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/progress.mjs\" --brief 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Loading build status"
          }
        ]
      }
    ]
  }
}
